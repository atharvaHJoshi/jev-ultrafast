TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Optional: base URL for the TypeSafe inference endpoint.
# TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Foreground owned tab: set to 1 if background tabs stop painting modal menus (Windows).
# TYPESAFE_FOREGROUND=0
